# Large / licensed data stays out of git (CC BY-NC 4.0, multi-GB)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
models/*
!models/.gitkeep
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# Kaggle upload bundle (WP14) and packaging outputs
dist/
build/
*.egg-info/
.pytest_cache/

# Tracked on purpose (PLAN.md section 7), do not ignore: splits/, submissions/, configs/
